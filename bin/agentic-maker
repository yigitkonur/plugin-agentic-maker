#!/bin/sh
# agentic-maker: CLI behind the /agentic-maker:* skills. Needs python3 >= 3.9 (standard library only).
# Runs the package in isolated mode (-I) so a file in the current directory can never shadow a stdlib module.
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
for py in python3 python; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 9) else 1)' 2>/dev/null; then
    exec "$py" -I "$ROOT/lib/agentic_maker/__main__.py" "$@"
  fi
done
printf '%s\n' '{"ok":false,"error":{"class":"internal","code":"python_missing","message":"python3 >= 3.9 was not found on PATH","retryable":false,"suggestion":"Install python3 3.9 or newer. The skills still work as plain text without this CLI."},"schema_version":1,"next_actions":[]}'
echo "agentic-maker: python3 >= 3.9 is required" >&2
exit 1
